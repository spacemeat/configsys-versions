{
    // AUTO-DERIVED version floors — DO NOT hand-edit; regenerate with
    //   tools/versionsweep.py --derive   (run with configsys-source loaded so its recipes are seen)
    // which reads each source-buildable component's built-tag Cargo.toml / go.mod. This file is
    // updated on `main` by the daily sweep, so the minimums track upstream without a release.
    //
    // `version-floors:` PATCHES the floor onto a component's existing cargo/go requirement without
    // redefining it, and only where that requirement exists — so a floor for a component you don't
    // build from source is simply unused. Covers core source bindings (fzf, …) and the
    // configsys-source recipes (ripgrep, lazygit, superfile).
    version-floors: {
        fzf:       { go: ">=1.23.0" }     // core source binding
        ripgrep:   { cargo: ">=1.85" }    // configsys-source recipe
        lazygit:   { go: ">=1.25.0" }     // configsys-source recipe
        superfile: { go: ">=1.25.7" }     // configsys-source recipe
    }
}
