{
    // configsys-versions — the auto-derived VERSION-FLOOR data channel. Data-only (it ships a
    // `version-floors:` section and nothing else), so there's no code and no trust step. It is
    // tracked on `main` and regenerated by the maintainer's daily sweep
    // (`tools/versionsweep.py --derive`), so a component's toolchain minimum — a Rust MSRV, a
    // go.mod `go` directive — stays current WITHOUT a configsys or plugin release.
    //
    // A floor only TIGHTENS an existing requirement (it never creates one), so it is INERT unless
    // you actually build that component from source: the floor for a configsys-source recipe does
    // nothing until configsys-source adds that source binding, and the floors for core source
    // bindings (fzf, …) apply only if you pin them `via: source`. That's why this is safe to load
    // broadly and to pin to `main` — worst case a floor sits unused.
    //
    // Loaded TRANSITIVELY by configsys-source (so source-build users get fresh floors for free),
    // and declarable DIRECTLY if you pin a core source binding without configsys-source. It stays a
    // visible, declared layer (`configsys plugin list`) — never an auto-loaded surprise.
    name: configsys-versions
    requires-abi: 1
    data: [ floors.hu ]
}
